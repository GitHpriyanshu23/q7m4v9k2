          </mxGeometry>
        </mxCell>
        <mxCell id="select" value="&lt;b&gt;1. Select the decision&lt;/b&gt;&lt;br&gt;January date + cutoff (09:00 default)&lt;br&gt;Delivery is the following day" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#285840;strokeColor=#285840;fontColor=#ffffff;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="175" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;2. Validate and load&lt;/b&gt;&lt;br&gt;FastAPI checks dates and time&lt;br&gt;Use cached indexes of bundled data" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="325" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="forecast" value="&lt;b&gt;3. Reconstruct the forecast&lt;/b&gt;&lt;br&gt;For each next-day delivery hour:&lt;br&gt;latest publication at/before cutoff&lt;br&gt;No eligible forecast stays missing" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="475" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="display" value="&lt;b&gt;4. Show the buying outlook&lt;/b&gt;&lt;br&gt;Forecast curve and energy total&lt;br&gt;Publication age, lead time, audit trail&lt;br&gt;Prior context shown alongside" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="665" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prior" value="&lt;b&gt;Earlier January decisions&lt;/b&gt;&lt;br&gt;Only decisions before the chosen date&lt;br&gt;Use the same selected cutoff policy&lt;br&gt;No full-month hindsight" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="475" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="asof" value="&lt;b&gt;Actuals available at cutoff&lt;/b&gt;&lt;br&gt;Only versions already published&lt;br&gt;Average both actual half-hours&lt;br&gt;Exclude future hours and revisions" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="665" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;Prior-history context&lt;/b&gt;&lt;br&gt;MAE, bias, P90 shortfall and count&lt;br&gt;Descriptive sample history only&lt;br&gt;Not a guaranteed reserve" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="855" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="actual" value="&lt;b&gt;Retrospective actuals&lt;/b&gt;&lt;br&gt;Latest versions in fixed snapshot&lt;br&gt;Never presented as known beforehand&lt;br&gt;Not an additional live data fetch" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#fcf6e9;strokeColor=#d3b784;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1045" y="475" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="align" value="&lt;b&gt;Align actuals to the hour&lt;/b&gt;&lt;br&gt;Mean of HH:00 and HH:30 actuals&lt;br&gt;Both half-hours must exist&lt;br&gt;Missing remains null; zero is valid" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#fcf6e9;strokeColor=#d3b784;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1045" y="665" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;Compute matched errors&lt;/b&gt;&lt;br&gt;Error = forecast minus actual&lt;br&gt;MAE, RMSE, bias, shortfall energy&lt;br&gt;Report matched / expected coverage" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#fcf6e9;strokeColor=#d3b784;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1045" y="855" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;5. Review the outcomes&lt;/b&gt;&lt;br&gt;Reveal actuals or open performance&lt;br&gt;Charts, hourly patterns, worst intervals&lt;br&gt;Clearly labelled retrospective" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#fcf6e9;strokeColor=#d3b784;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="1040" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="export" value="&lt;b&gt;6. Export for review&lt;/b&gt;&lt;br&gt;CSV keeps selected dates and cutoff&lt;br&gt;Forecast, actual, error, timestamps" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="1230" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="footnote" value="Source: implemented analysis rules. January 1–31 decisions deliver January 2–February 1. National wind exposure is not a client purchase order." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#64786a;" vertex="1" parent="1">
          <mxGeometry x="48" y="1360" width="1340" height="38" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
