          <mxGeometry x="40" y="410" width="1360" height="410" as="geometry" />
        </mxCell>
        <mxCell id="band-2" value="03 / TWO WAYS TO RUN THE SAME APPLICATION" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#f5f6f1;strokeColor=#dce4d8;fontSize=12;fontStyle=1;fontColor=#64786a;" vertex="1" parent="1">
