          </mxGeometry>
        </mxCell>
        <mxCell id="edge-7" value="Indexed data" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#9aafa0;strokeWidth=2;fontSize=12;fontColor=#64786a;labelBackgroundColor=#fafbf7;dashed=0;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cache" target="analysis">
