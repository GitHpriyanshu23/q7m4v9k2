            <mxPoint x="1205" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sources" value="&lt;b&gt;Elexon public APIs&lt;/b&gt;&lt;br&gt;WINDFOR: forecast + publication time&lt;br&gt;FUELHH: half-hour actuals, WIND only&lt;br&gt;No additional market datasets" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="&lt;b&gt;Offline ingestion&lt;/b&gt;&lt;br&gt;scripts/ingest.py — manual run&lt;br&gt;Download, retry, validate, normalize&lt;br&gt;No download on a dashboard request" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="210" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="snapshot" value="&lt;b&gt;Bundled evidence&lt;/b&gt;&lt;br&gt;windfor.json.gz + fuelhh.json.gz&lt;br&gt;manifest.json: URLs, time, counts, hashes&lt;br&gt;Fixed historical snapshot; no database" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1040" y="210" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="react" value="&lt;b&gt;Buyer / React browser app&lt;/b&gt;&lt;br&gt;Date, cutoff, date range, view selection&lt;br&gt;Recharts, audit trail, actuals toggle&lt;br&gt;TypeScript + Vite; same-origin requests&lt;br&gt;Does not calculate accuracy formulas" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Python FastAPI&lt;/b&gt;&lt;br&gt;backend/main.py + api/index.py&lt;br&gt;Validate request; call analysis functions&lt;br&gt;Decision, performance, metadata, CSV&lt;br&gt;Return computed JSON or CSV" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="555" y="470" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="analysis" value="&lt;b&gt;Pure analysis functions&lt;/b&gt;&lt;br&gt;backend/analysis.py&lt;br&gt;Latest publication at/before cutoff&lt;br&gt;Average two half-hour actuals&lt;br&gt;MAE, RMSE, bias, shortfall, coverage" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1040" y="470" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Memory cache / indexes&lt;/b&gt;&lt;br&gt;Lazy load per Python process&lt;br&gt;Snapshot indexes + selected-day results" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1040" y="685" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="timing" value="&lt;b&gt;Two separate information views&lt;/b&gt;&lt;br&gt;Decision context: earlier decisions and actual versions available by current cutoff.&lt;br&gt;Retrospective review: latest actual versions in the bundled snapshot." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#fcf6e9;strokeColor=#d3b784;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="685" width="815" height="100" as="geometry" />
        </mxCell>
        <mxCell id="vercel" value="&lt;b&gt;Current public deployment — Vercel&lt;/b&gt;&lt;br&gt;Static React assets served by Vercel&lt;br&gt;/api/* rewrites to a Python function exposing FastAPI&lt;br&gt;Snapshot files are included in the function bundle" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#edf3e7;strokeColor=#9eb391;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="890" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;Separate container path — Docker&lt;/b&gt;&lt;br&gt;Node build stage creates the React production files&lt;br&gt;Non-root Python + Uvicorn serves UI and API together&lt;br&gt;Docker Compose gives one-command local startup" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#cbd8c9;fontColor=#243e30;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="740" y="890" width="630" height="120" as="geometry" />
        </mxCell>
        <mxCell id="footnote" value="Source: implemented repository. Pilot has no live ingestion scheduler, shared database, trained wind model, or trade execution." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#64786a;" vertex="1" parent="1">
          <mxGeometry x="48" y="1050" width="1340" height="38" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>