        <mxCell id="heading" value="&lt;b&gt;How Windward is built&lt;/b&gt;&lt;br&gt;Offline preparation is separate from interactive analysis. Vercel and Docker are different deployment paths." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#243e30;" vertex="1" parent="1">
          <mxGeometry x="48" y="20" width="1330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="band-0" value="01 / OFFLINE DATA PREPARATION" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fillColor=#f0f4eb;strokeColor=#dce4d8;fontSize=12;fontStyle=1;fontColor=#64786a;" vertex="1" parent="1">
