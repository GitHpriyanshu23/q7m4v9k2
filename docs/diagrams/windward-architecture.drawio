  <diagram id="windward-architecture" name="How Windward is built">
    <mxGraphModel dx="1440" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1100" math="0" shadow="0">
      <root>
